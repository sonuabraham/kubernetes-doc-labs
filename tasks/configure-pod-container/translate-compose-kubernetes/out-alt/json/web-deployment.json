        "creationTimestamp": null,
        "labels": {
          "io.kompose.service": "web"
        },
        "annotations": {
          "kompose.cmd": "../bin/kompose convert -f ../docker-compose.yml -j -o json/",
          "kompose.service.type": "LoadBalancer",
          "kompose.version": "1.34.0 (cbf2835db)"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "web",
            "image": "quay.io/kompose/web",
            "ports": [
              {
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "GET_HOSTS_FROM",
                "value": "dns"
              }
            ],
            "resources": {}
          }
        ],
        "restartPolicy": "Always"
