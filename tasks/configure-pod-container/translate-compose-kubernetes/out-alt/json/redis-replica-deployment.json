{
  "kind": "Deployment",
  "apiVersion": "apps/v1",
  "metadata": {
    "name": "redis-replica",
    "creationTimestamp": null,
    "labels": {
      "io.kompose.service": "redis-replica"
    },
    "annotations": {
      "kompose.cmd": "../bin/kompose convert -f ../docker-compose.yml -j -o json/",
      "kompose.version": "1.34.0 (cbf2835db)"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "io.kompose.service": "redis-replica"
      }
    },
    "template": {
      "metadata": {
        "creationTimestamp": null,
        "labels": {
          "io.kompose.service": "redis-replica"
        },
        "annotations": {
          "kompose.cmd": "../bin/kompose convert -f ../docker-compose.yml -j -o json/",
          "kompose.version": "1.34.0 (cbf2835db)"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "redis-replica",
            "image": "redis",
            "args": [
              "redis-server",
              "--replicaof",
              "redis-leader",
              "6379",
              "--dir",
              "/tmp"
            ],
            "ports": [
              {
                "containerPort": 6379,
                "protocol": "TCP"
              }
            ],
            "resources": {}
          }
        ],
        "restartPolicy": "Always"
      }
    },
    "strategy": {}
  },
  "status": {}
}