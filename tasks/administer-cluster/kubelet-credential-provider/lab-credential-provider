#!/bin/sh
# A minimal kubelet image credential provider exec plugin (not from the docs).
# The kubelet runs it with a CredentialProviderRequest (JSON) on stdin, e.g.
#   {"kind":"CredentialProviderRequest","apiVersion":"credentialprovider.kubelet.k8s.io/v1","image":"localhost:5000/private/busybox:1.36"}
# and expects a CredentialProviderResponse on stdout, in the SAME apiVersion.
# A real plugin would fetch short-lived credentials from a cloud API / metadata server here.
# Every request is appended to /var/log/lab-credential-provider.log so you can watch the kubelet call it.
REQ=$(cat)
echo "$(date +%T) args=[$*] request=$REQ" >> /var/log/lab-credential-provider.log
cat <<EOF
{
  "apiVersion": "credentialprovider.kubelet.k8s.io/v1",
  "kind": "CredentialProviderResponse",
  "cacheKeyType": "Registry",
  "cacheDuration": "1m",
  "auth": {
    "localhost:5000": {"username": "labuser", "password": "labpass"}
  }
}
EOF
