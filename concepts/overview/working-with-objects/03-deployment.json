{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": { "name": "nginx-deployment-json" },
  "spec": {
    "replicas": 1,
    "selector": { "matchLabels": { "app": "nginx-json" } },
    "template": {
      "metadata": { "labels": { "app": "nginx-json" } },
      "spec": { "containers": [ { "name": "nginx", "image": "nginx:1.14.2", "ports": [ { "containerPort": 80 } ] } ] }
    }
  }
}
